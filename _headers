# Response headers for citeonly.com, read by Cloudflare (Workers static assets); not served as a file there.
# Founder, 2 Oct 2026, taps b7 and b8. _redirects runs first. GitHub Pages ignores this file.
# Fonts carry a content hash in their names, and CSS and JS a ?v= hash in their URLs, so all three are kept for a
# year; a change is a new name. Pages themselves are always re-checked, so a deploy reaches everyone at once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://docs.google.com; form-action 'self' https://docs.google.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800
